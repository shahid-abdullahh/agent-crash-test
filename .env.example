# Database Persistence (Optional: Omit or leave empty for fast In-Memory mode)
# Local SQLite example: sqlite:///./agent_crash_test.db
# PostgreSQL example: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/agent_crash_test
DATABASE_URL=

# Backend Host & Port
HOST=127.0.0.1
PORT=8000

# Optional Live LLM Provider (Optional: Deterministic & Mock providers run with 0 credentials)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
